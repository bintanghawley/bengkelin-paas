APP_NAME=Bengkelin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Railway Live Console: ganti ke 'stderr' jika deploy di Railway
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================================
# 1. DATABASE CONFIGURATION
# =========================================================================
# Untuk Lokal (XAMPP MySQL):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bengkelin
DB_USERNAME=root
DB_PASSWORD=

# Untuk Cloud PaaS (Supabase PostgreSQL):
# Salin URI dari Supabase Project Settings -> Database -> Connection string (URI)
# Contoh URI: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DB_CONNECTION=pgsql
# DATABASE_URL=
# Atau parameter terpisah:
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.[project-ref]
# DB_PASSWORD=
# DB_SSLMODE=require

# =========================================================================
# 2. SESSION & CACHE CONFIGURATION
# =========================================================================
# Gunakan 'database' di Railway agar sesi login tidak hilang saat server restart
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# =========================================================================
# 3. STORAGE CONFIGURATION (Backblaze B2 / S3-Compatible)
# =========================================================================
# Untuk Lokal:
FILESYSTEM_DISK=local

# Untuk Cloud Storage (Backblaze B2):
# 1. Ubah FILESYSTEM_DISK=s3
# 2. Ambil Application Key dari Backblaze B2 (Read and Write permissions)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_backblaze_keyID
# AWS_SECRET_ACCESS_KEY=your_backblaze_applicationKey
# AWS_DEFAULT_REGION=us-west-004
# AWS_BUCKET=your-b2-bucket-name
# AWS_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL=https://f004.backblazeb2.com/file/your-b2-bucket-name

# =========================================================================
# 4. MAIL CONFIGURATION (Optional)
# =========================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bengkelin.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
